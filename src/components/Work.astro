---
import Projects from './Projects.astro';
import Clients from './Clients.astro';
import workData from '../data/workData.json';

/**
 * Work component.
 */
---

<section id="work" class="work">
	<h2>My Work</h2>
	<h3>Featured Projects</h3>
	<Projects projectsListData={workData.workData.projects} />

	<h3>Some of my previous clients</h3>
	<Clients clientsListData={workData.workData.clients} />

	<h3>Code samples</h3>
	<p>
		Most of my recent work lives in private client repositories, but you can still see it in action: check out my <a href="#speaking">conference talks</a> for deep dives into real projects, including code walkthroughs, or <a href="https://github.com/joeleenk">visit my GitHub</a> — the source for this site lives there.
	</p>
	<p>
		<a title="Email Joeleen" href="mailto:joeleenk@gmail.com">Get in touch</a> if you'd like to see something more specific — I'm happy to accommodate when I can.
	</p>
</section>
